# Discord Bot 環境變數範本
# 複製為 .env 並填入實際值。不得提交至版本控制。

# --- Discord Bot ---
# 從 Discord Developer Portal 取得之 bot token
DISCORD_BOT_TOKEN=

# Discord Application ID（用於 slash command 註冊）
DISCORD_APP_ID=

# （選填）限制 slash command 僅註冊於指定 guild，加速開發階段同步
# 留空則註冊為全域指令
DISCORD_GUILD_ID=

# --- 後端連線 ---
BACKEND_URL=http://127.0.0.1:8000
ADMIN_TOKEN=CHANGEME

# Notify server port，與 Telegram bot 使用不同 port 以避免衝突
NOTIFY_PORT=9877

# --- 退款建議上限（警示但允許通過） ---
REFUND_MAX_PER_ORDER=50000
REFUND_DAILY_QUOTA=100000
REFUND_DAILY_COUNT_CAP=20
