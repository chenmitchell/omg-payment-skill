# Telegram Bot 環境變數範本
# 複製為 .env 並填入實際值。不得提交至版本控制。

# --- Telegram Bot ---
# 從 @BotFather 取得之 bot token
TG_BOT_TOKEN=

# --- 後端連線 ---
# Bot 與後端 API 通訊之位址
BACKEND_URL=http://127.0.0.1:8000

# Admin token，用於 bot 呼叫 admin endpoint 之身分驗證
# 建議以 python -c "import secrets; print(secrets.token_hex(16))" 產生
ADMIN_TOKEN=CHANGEME

# Notify server port，後端於此 port 推送通知至 bot
NOTIFY_PORT=9876

# --- 退款建議上限（警示但允許通過） ---
# 下列三個值為「警示依據」，超過時會於二次確認對話框顯示警示，
# 但不會阻擋退款執行。使用者仍可選擇按下確認按鈕完成退款。
# 若商家規模較大，可依實際營運調整。

# 單筆退款建議上限（TWD）
REFUND_MAX_PER_ORDER=50000

# 每日退款總金額建議上限（TWD）
REFUND_DAILY_QUOTA=100000

# 每日退款次數建議上限
REFUND_DAILY_COUNT_CAP=20
