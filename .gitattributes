# .gitattributes — 確保跨平台換行與二進位處理一致
* text=auto eol=lf

# 文字檔
*.md        text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.php       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.cff       text eol=lf

# Windows 批次檔
*.bat       text eol=crlf
*.cmd       text eol=crlf

# 二進位檔（若未來加入）
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary

# GitHub linguist 分類：排除模板中的範例 HTML / 排除 guides 的 markdown 不影響語言統計
guides/**   linguist-documentation
docs/**     linguist-documentation
references/** linguist-documentation
templates/** linguist-vendored=false
