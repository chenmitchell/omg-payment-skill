*.key
*.pem
secrets/
credentials/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
venv/
.venv/
env/

# ---- Node.js / TypeScript ----
node_modules/
dist/
build/
.npm/
.yarn/
yarn-error.log
npm-debug.log*
*.tsbuildinfo
.next/
.nuxt/

# ---- PHP / Laravel ----
vendor/
.phpunit.result.cache
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*
!storage/logs/.gitkeep

# ---- IDE ----
.idea/
.vscode/
!.vscode/settings.json.example
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- 作業系統 ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

