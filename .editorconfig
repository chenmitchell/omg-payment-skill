# EditorConfig — https://editorconfig.org
# 本 repo 採用統一的編碼風格，請確保編輯器已安裝 EditorConfig plugin
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.{js,jsx,ts,tsx}]
indent_size = 2

[*.{py,sh}]
indent_size = 4

[*.{php,html,css}]
indent_size = 4

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
